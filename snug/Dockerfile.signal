# Builds and runs ONLY the signaling server (server/index.mjs) — not the
# Next.js app. Explicit Dockerfile instead of relying on Railway's
# auto-detected build/start commands, which kept picking "next build" /
# "next start" since this repo's package.json also contains the frontend.
FROM node:22-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
# --ignore-scripts because package.json's postinstall copies the RNNoise
# worklet and .wasm files out of node_modules into public/ — a browser-side
# concern for the Next.js app. This image has neither scripts/ nor public/,
# so the hook dies on a missing module and takes the whole build with it.
# Nothing the signaling server imports has a meaningful install script.
RUN npm install --omit=dev --ignore-scripts
COPY server ./server

EXPOSE 3001
CMD ["node", "server/index.mjs"]
